# Every knob, with the default the code uses. Copy to <home>/.env or export.
# BYO_HOME defaults to ~/.byo
BYO_HOME=
BYO_PROVIDER=anthropic
BYO_API_KEY=
BYO_BASE_URL=
BYO_MODEL=
BYO_SMALL_MODEL=
BYO_MAX_ITERATIONS=15
BYO_MAX_TOKENS=8192
BYO_HISTORY_TURNS=12
BYO_CONSOLIDATE_EVERY=6
BYO_RETRIEVAL_TOP_K=4
BYO_PORT=7777
BYO_WEATHER_ENABLED=true
BYO_WEATHER_TIMEOUT_SECONDS=5
BYO_WEATHER_DEFAULT_PLACE=
